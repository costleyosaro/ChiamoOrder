# .env.example - Copy to .env and fill in real values
# DO NOT commit .env to Git!

# ============ SUPERUSER ============
SUPERUSER_BUSINESS_NAME=YourAdminName
SUPERUSER_EMAIL=admin@yourdomain.com
SUPERUSER_PASSWORD=your_secure_password_here

# ============ STAFF USERS ============
INVOICER_BUSINESS_NAME=ChiamoOrder Invoicing
INVOICER_EMAIL=invoicer@chiamoorder.com
INVOICER_PASSWORD=your_password_here

LOGISTICS_BUSINESS_NAME=ChiamoOrder Logistics
LOGISTICS_EMAIL=logistics@chiamoorder.com
LOGISTICS_PASSWORD=your_password_here

INVENTORY_BUSINESS_NAME=ChiamoOrder Inventory
INVENTORY_EMAIL=inventory@chiamoorder.com
INVENTORY_PASSWORD=your_password_here

SUPPORT_BUSINESS_NAME=ChiamoOrder Support
SUPPORT_EMAIL=support@chiamoorder.com
SUPPORT_PASSWORD=your_password_here

FINANCE_BUSINESS_NAME=ChiamoOrder Finance
FINANCE_EMAIL=finance@chiamoorder.com
FINANCE_PASSWORD=your_password_here

# ============ DJANGO ============
SECRET_KEY=your_django_secret_key_here
DEBUG=False

# ============ DATABASE ============
DATABASE_URL=postgres://user:password@host:port/dbname

# ============ EMAIL (BREVO/SENDINBLUE) ============
BREVO_API_KEY=xkeysib-your-api-key-here
SENDER_EMAIL=your-email@example.com